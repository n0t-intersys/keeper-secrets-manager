# .env.template — maps environment variables to Keeper secrets.
#
# This file is SAFE to commit: it contains references, not secrets.
# Generate a real .env with:  python ksm/gen_env.py
# The generated .env holds plaintext secrets — it is gitignored; never commit it.
#
# Rules:
#   VAR=keeper://<notation>   -> resolved from Keeper Secrets Manager
#   VAR=<anything else>       -> copied through literally (non-secret config)
#
# Notation: keeper://<RecordUID>/field/<name>   (login, password, url, ...)
#           keeper://<RecordUID>/custom_field/<label>

# --- Literal (non-secret) config, passed through as-is ---
APP_ENV=production
LOG_LEVEL=info

# --- Pulled from Keeper (replace RecordUID + field names with yours) ---
DB_USERNAME=keeper://RecordUID/field/login
DB_PASSWORD=keeper://RecordUID/field/password
API_KEY=keeper://RecordUID/custom_field/API Key
